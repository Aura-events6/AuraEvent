{
  "expo": {
    "name": "Aura",
    "slug": "aura-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#101012"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101012"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "0d619d23-4a68-48f1-a9aa-282e22f54cb7"
      }
    }
  }
}
